{
  "name": "jarvis-desktop",
  "version": "0.4.0",
  "private": true,
  "description": "21 — Personal AI by 21Robotics",
  "author": "21Robotics",
  "license": "UNLICENSED",
  "type": "module",
  "main": "dist-electron/main.cjs",
  "engines": {
    "node": ">=22.12.0 <23"
  },
  "scripts": {
    "postinstall": "node scripts/install-electron.mjs",
    "dev": "node scripts/dev.mjs",
    "dev:web": "vite --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "voice:models": "node scripts/build-electron.mjs && node dist-electron/voice-models-cli.cjs",
    "voice:check": "node scripts/build-electron.mjs && node dist-electron/verify-voice.cjs",
    "build": "npm run typecheck && vite build && node scripts/build-electron.mjs",
    "start": "electron .",
    "package": "npm run build && npm run backend:bundle && electron-builder --dir",
    "dist:mac": "npm run build && npm run backend:bundle -- --mac && electron-builder --mac",
    "check:compat": "node scripts/check-compatibility.mjs",
    "dist:win": "npm run build && npm run backend:bundle -- --win && electron-builder --win",
    "backend:setup": "node scripts/setup-backend.mjs",
    "test:backend": "node scripts/test-backend.mjs",
    "backend:bundle": "node scripts/bundle-backend.mjs",
    "engine:tools": "node scripts/backend-task.mjs scripts/install-engine-tools.py",
    "engine:build": "node scripts/backend-task.mjs scripts/build-local-engine.py",
    "engine:benchmark": "node scripts/backend-task.mjs scripts/benchmark-local-ai.py"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sherpa-onnx": "1.13.8",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.186.0",
    "@vitejs/plugin-react": "6.1.2",
    "electron": "43.8.3",
    "electron-builder": "26.15.3",
    "esbuild": "0.28.2",
    "typescript": "5.9.3",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  },
  "build": {
    "appId": "ro.21robotics.jarvis",
    "productName": "21",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "dist-electron/voice-worker.cjs",
      "node_modules/sherpa-onnx/**/*"
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "minimumSystemVersion": "12.0",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64"
          ]
        }
      ],
      "extendInfo": {
        "NSMicrophoneUsageDescription": "21 processes microphone audio locally for wake-word detection, speech recognition and avatar animation. Gemini speech receives audio only after you enable cloud speech and explicitly consent. No microphone recording is saved to disk.",
        "NSCameraUsageDescription": "Camera features are not available in this version."
      }
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Utility"
    },
    "extraResources": [
      {
        "from": "services/backend",
        "to": "backend",
        "filter": [
          "jarvis_backend/**/*.py",
          "requirements.lock"
        ]
      },
      {
        "from": ".cache/backend-bundle/${os}/python",
        "to": "backend-python"
      }
    ]
  }
}
